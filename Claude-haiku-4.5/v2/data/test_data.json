      "expected_error": "no_path_found",
      "graph_file": "graph_disconnected.json"
    },
    {
      "name": "negative_cycle_detection",
      "graph_version": "v1_cycle",
      "source": "A",
      "destination": "C",
      "expected_path": null,
      "expected_cost": null,
